{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ResinForge",
  "version": "0.3.0",
  "identifier": "com.resinforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8123/studio.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResinForge",
        "url": "studio.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNzVEQzJCNDhGNjdCMUYKUldRZmUvWklLOXgxZ0RCejI3UmNpVThrY29kWGU4RDEveFV5S0NrOG1ZNktuSFYwbm5lc00zV20K",
      "endpoints": [
        "http://82.157.179.191:3000/admin/open-support/releases/latest/download/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
