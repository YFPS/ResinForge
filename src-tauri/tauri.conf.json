{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ResinForge",
  "version": "0.2.0",
  "identifier": "com.resinforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8123/studio.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResinForge",
        "url": "studio.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
